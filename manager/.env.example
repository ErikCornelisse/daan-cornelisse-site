# Document every environment variable here. Real values go in .env (gitignored).
# Format: KEY=default_or_example_value

# Root of the Astro site this manager edits (the folder with astro.config.mjs).
SITE_ROOT=..

# Address the manager listens on. 127.0.0.1 = this Mac only; 0.0.0.0 = also
# the local network and Tailscale (use that on the Mac mini).
MANAGER_HOST=127.0.0.1
MANAGER_PORT=8765

# Port of the Astro preview server started by the manager.
PREVIEW_PORT=4321

# Author of the commits made when publishing, as "Name <email>". Leave empty to
# use the git identity of this Mac.
PUBLISH_AUTHOR=
