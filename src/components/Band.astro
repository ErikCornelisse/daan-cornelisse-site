---
// Full-width band with one of the two mockup backgrounds; content sits in
// the centred container. A band is only visual: sections and topics supply
// the structure (<section>, <article>) around or inside it.
interface Props {
	variant?: 'cream' | 'paper';
	id?: string;
	class?: string;
}

const { variant = 'cream', id, class: className } = Astro.props;
const texture = `url(${import.meta.env.BASE_URL.replace(/\/?$/, '/')}textures/paper.svg)`;
---

<div id={id} class:list={['band', `band--${variant}`, className]} style={`--paper-texture: ${texture}`}>
	<div class="container">
		<slot />
	</div>
</div>

<style>
	.band {
		padding-block: var(--space-xl);
	}

	.band--cream {
		background-color: var(--color-cream);
	}

	.band--paper {
		background-color: var(--color-paper);
		background-image: var(--paper-texture);
		background-size: 320px 320px;
	}
</style>
