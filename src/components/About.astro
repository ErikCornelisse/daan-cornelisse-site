---
// "Over mij": portrait above the text on phones, side by side from 48rem.
// Text and alt text come from src/content/pages/<lang>/about.md.
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import portrait from '../assets/images/portret.jpg';

interface Props {
	page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<div class="about">
	<h2 class="about__title">{page.data.title}</h2>
	<Image
		class="about__portrait"
		src={portrait}
		alt={page.data.imageAlt ?? ''}
		widths={[400, 560, 680]}
		sizes="(min-width: 48rem) 22rem, 100vw"
	/>
	<div class="about__text flow">
		<Content />
	</div>
</div>

<style>
	.about {
		display: grid;
		gap: var(--space-l);
	}

	.about__title {
		text-align: center;
	}

	.about__portrait {
		width: 100%;
		max-width: 26rem;
		margin-inline: auto;
	}

	.about__text {
		max-width: var(--measure);
	}

	@media (min-width: 48rem) {
		.about {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
			column-gap: var(--space-l);
			align-items: start;
		}

		.about__title {
			grid-column: 1 / -1;
		}

		.about__portrait {
			margin: 0;
		}
	}
</style>
