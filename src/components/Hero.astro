---
// Full-bleed photo with title block. Phones get a portrait crop, wider
// screens the wide crop; the bottom edge fades into the cream band below.
// The two crops are placeholders cut from the mockup until Daan's photos arrive.
import { getImage } from 'astro:assets';
import portrait from '../assets/images/hero-portrait.jpg';
import wide from '../assets/images/hero-wide.jpg';

interface Props {
	title: string;
	subtitle?: string;
	cta?: string;
	ctaHref?: string;
	imageAlt: string;
}

const { title, subtitle, cta, ctaHref, imageAlt } = Astro.props;

const portraitImg = await getImage({ src: portrait, widths: [480, 760], format: 'webp', quality: 72 });
const wideImg = await getImage({ src: wide, widths: [1024, 1600, 2400], format: 'webp', quality: 72 });
---

<section class="hero">
	<picture>
		<source media="(min-width: 48rem)" srcset={wideImg.srcSet.attribute} sizes="100vw" type="image/webp" />
		<img
			src={portraitImg.src}
			srcset={portraitImg.srcSet.attribute}
			sizes="100vw"
			width={portrait.width}
			height={portrait.height}
			alt={imageAlt}
			fetchpriority="high"
			decoding="async"
		/>
	</picture>
	<div class="hero__text container">
		<h1>{title}</h1>
		{subtitle && <p class="hero__subtitle">{subtitle}</p>}
		{cta && ctaHref && <a class="hero__cta" href={ctaHref}>{cta}</a>}
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: var(--color-dark);
		color: var(--color-on-photo);
	}

	picture {
		display: block;
	}

	img {
		width: 100%;
		height: clamp(30rem, 88svh, 46rem);
		object-fit: cover;
		object-position: 50% 35%;
	}

	/* Darken the top for the text, fade the bottom into the next band */
	.hero::before,
	.hero::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		pointer-events: none;
	}

	.hero::before {
		top: 0;
		height: 60%;
		background: linear-gradient(to bottom, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0));
	}

	/* Ends in solid cream a little before the edge, so no seam shows on
	   fractional pixel heights */
	.hero::after {
		bottom: -1px;
		height: 22%;
		background: linear-gradient(to bottom, transparent, var(--color-cream) 92%);
	}

	.hero__text {
		position: absolute;
		inset-inline: 0;
		top: calc(var(--touch-target) + var(--space-l));
		z-index: 1;
		display: grid;
		gap: var(--space-xs);
		justify-items: start;
	}

	h1 {
		max-width: 14ch;
	}

	.hero__subtitle {
		max-width: 28ch;
		font-size: var(--step-1);
	}

	.hero__cta {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-target);
		font-weight: 700;
		font-size: var(--step-0);
	}

	.hero__cta:focus-visible {
		outline-color: var(--color-on-photo);
	}

	@media (min-width: 48rem) {
		img {
			height: clamp(28rem, 56vw, 52rem);
			object-position: 50% 50%;
		}

		h1 {
			max-width: 26ch;
		}
	}
</style>
