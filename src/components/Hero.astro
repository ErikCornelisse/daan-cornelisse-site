---
// The hero: full-bleed photo with title block, always the first section.
// Phones get the portrait crop when there is one, otherwise the wide photo;
// the bottom edge fades into the first band. Content comes from
// src/content/sections/<lang>/hero.md.
import { getImage } from 'astro:assets';
import type { ResolvedSection } from '../lib/page';

interface Props {
	section: ResolvedSection;
	/** Anchor of the section the hero's link points to. */
	linkAnchor?: string;
}

const { section, linkAnchor } = Astro.props;
const { title, subtitle, cta, image, portrait, focus } = section.entry.data;
const ctaHref = linkAnchor ? `#${linkAnchor}` : undefined;
// The focal point keeps the subject in view when the wide photo is cropped;
// on phones it applies only when there is no separate portrait crop.
const focusStyle = focus
	? `--focus-wide: ${focus};${portrait ? '' : ` --focus-phone: ${focus};`}`
	: undefined;

const phone = portrait ?? image?.src;
const phoneImg = phone && (await getImage({ src: phone, widths: [480, 760], format: 'webp', quality: 72 }));
const wideImg = image && (await getImage({ src: image.src, widths: [1024, 1600, 2400], format: 'webp', quality: 72 }));
---

<section
	class="hero"
	aria-labelledby={section.headingId}
	lang={section.fallback ? section.lang : undefined}
	style={focusStyle}
>
	{
		phone && phoneImg && wideImg && (
			<picture>
				<source media="(min-width: 48rem)" srcset={wideImg.srcSet.attribute} sizes="100vw" type="image/webp" />
				<img
					src={phoneImg.src}
					srcset={phoneImg.srcSet.attribute}
					sizes="100vw"
					width={phone.width}
					height={phone.height}
					alt={image?.alt ?? ''}
					fetchpriority="high"
					decoding="async"
				/>
			</picture>
		)
	}
	<div class="hero__text container">
		<h1 id={section.headingId}>{title}</h1>
		{subtitle && <p class="hero__subtitle">{subtitle}</p>}
		{cta && ctaHref && <a class="hero__cta" href={ctaHref}>{cta}</a>}
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: var(--color-dark);
		color: var(--color-on-photo);
	}

	picture {
		display: block;
	}

	img {
		width: 100%;
		height: clamp(30rem, 88svh, 46rem);
		object-fit: cover;
		object-position: var(--focus-phone, 50% 35%);
	}

	/* Darken the top for the text, fade the bottom into the next band */
	.hero::before,
	.hero::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		pointer-events: none;
	}

	.hero::before {
		top: 0;
		height: 60%;
		background: linear-gradient(to bottom, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0));
	}

	/* Ends in solid cream a little before the edge, so no seam shows on
	   fractional pixel heights */
	.hero::after {
		bottom: -1px;
		height: 22%;
		background: linear-gradient(to bottom, transparent, var(--color-cream) 92%);
	}

	.hero__text {
		position: absolute;
		inset-inline: 0;
		top: calc(var(--touch-target) + var(--space-l));
		z-index: 1;
		display: grid;
		gap: var(--space-xs);
		justify-items: start;
	}

	h1 {
		max-width: 14ch;
	}

	.hero__subtitle {
		max-width: 28ch;
		font-size: var(--step-1);
	}

	.hero__cta {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-target);
		font-weight: 700;
		font-size: var(--step-0);
	}

	.hero__cta:focus-visible {
		outline-color: var(--color-on-photo);
	}

	@media (min-width: 48rem) {
		img {
			height: clamp(28rem, 56vw, 52rem);
			object-position: var(--focus-wide, 50% 50%);
		}

		h1 {
			max-width: 26ch;
		}
	}
</style>
