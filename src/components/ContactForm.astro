---
// Contact form posting to Web3Forms. Without JavaScript the browser posts
// straight to the service; with JavaScript the result is shown in place.
// While src/data/site.json has no access key the form is shown but sends
// nothing, and says so.
import site from '../data/site.json';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { endpoint, accessKey } = site.contactForm;
const connected = accessKey !== '';
---

<form
	class="contact-form flow"
	method="post"
	action={connected ? endpoint : undefined}
	data-connected={connected ? 'true' : 'false'}
	data-msg-sending={t('form.sending')}
	data-msg-success={t('form.success')}
	data-msg-error={t('form.error')}
	data-msg-not-connected={t('form.notConnected')}
>
	<input type="hidden" name="access_key" value={accessKey} />
	<input type="hidden" name="subject" value={t('form.subject')} />
	<input type="hidden" name="from_name" value="Daan Cornelisse website" />
	<!-- Honeypot: people never see or fill this field -->
	<input type="checkbox" name="botcheck" class="contact-form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

	<div class="field">
		<label for={`name-${lang}`}>{t('form.name')}</label>
		<input id={`name-${lang}`} name="name" type="text" autocomplete="name" required />
	</div>
	<div class="field">
		<label for={`email-${lang}`}>{t('form.email')}</label>
		<input id={`email-${lang}`} name="email" type="email" autocomplete="email" required />
	</div>
	<div class="field">
		<label for={`message-${lang}`}>{t('form.message')}</label>
		<textarea id={`message-${lang}`} name="message" rows="6" required></textarea>
	</div>

	<p class="contact-form__privacy">{t('form.privacy')}</p>
	<button type="submit">{t('form.send')}</button>
	<p class="contact-form__status" role="status" aria-live="polite"></p>
</form>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>('.contact-form')) {
		const status = form.querySelector<HTMLElement>('.contact-form__status')!;
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const msg = form.dataset;

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (msg.connected !== 'true') {
				status.textContent = msg.msgNotConnected ?? '';
				return;
			}
			button.disabled = true;
			status.textContent = msg.msgSending ?? '';
			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { Accept: 'application/json' },
					body: new FormData(form),
				});
				const result = await response.json();
				if (!response.ok || !result.success) throw new Error(result.message);
				form.reset();
				status.textContent = msg.msgSuccess ?? '';
			} catch {
				status.textContent = msg.msgError ?? '';
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	.contact-form {
		--flow-space: var(--space-s);
	}

	.field {
		display: grid;
		gap: var(--space-2xs);
	}

	label {
		font-family: var(--font-heading);
	}

	input,
	textarea {
		width: 100%;
		min-height: var(--touch-target);
		padding: var(--space-xs) var(--space-s);
		border: 1px solid var(--color-ink);
		border-radius: 2px;
		background: rgb(255 255 255 / 0.55);
		color: var(--color-ink);
		font: inherit;
	}

	textarea {
		resize: vertical;
	}

	.contact-form__trap {
		position: absolute;
		left: -10000px;
	}

	.contact-form__privacy {
		font-size: var(--step--1);
	}

	button {
		min-height: var(--touch-target);
		padding-inline: var(--space-m);
		border: 0;
		border-radius: 2px;
		background: var(--color-brush);
		color: var(--color-brush-text);
		font-family: var(--font-heading);
		font-size: var(--step-0);
		cursor: pointer;
	}

	button:disabled {
		opacity: 0.6;
		cursor: progress;
	}

	.contact-form__status:empty {
		display: none;
	}
</style>
