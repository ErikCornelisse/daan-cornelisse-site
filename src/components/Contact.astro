---
// Contact section: intro text with e-mail and profile links, and the brush
// button from the mockup. The button opens the contact form underneath it
// (a <details> element, so it works without JavaScript).
import { render, type CollectionEntry } from 'astro:content';
import ContactForm from './ContactForm.astro';
import SocialLinks from './SocialLinks.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
	page: CollectionEntry<'pages'>;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(page);
---

<div class="contact">
	<h2 class="contact__title">{page.data.title}</h2>
	<div class="contact__intro flow">
		<Content />
		<SocialLinks lang={lang} />
	</div>
	<details class="contact__form">
		<summary class="brush-button">
			<svg class="brush-button__stroke" viewBox="0 0 300 84" preserveAspectRatio="none" aria-hidden="true">
				<path
					d="M10 20C46 8 118 13 176 9c46-3 86-6 112 6 7 14-2 33 5 47-46 13-104 9-162 12-46 2-86 5-122-4-6-16 3-34-1-50Z"
				/>
				<path d="M22 14c40-6 90-5 128-7M150 77c50-2 96 0 128-6M4 46c-2 6 0 12 3 16" fill="none" stroke-width="3" />
			</svg>
			<span class="brush-button__label">{t('contact.open')}</span>
		</summary>
		<ContactForm lang={lang} />
	</details>
</div>

<style>
	.contact {
		display: grid;
		gap: var(--space-l);
	}

	.contact__title {
		text-align: center;
	}

	.contact__intro {
		max-width: var(--measure);
	}

	.contact__form[open] > summary {
		margin-bottom: var(--space-l);
	}

	/* Brush-stroke button */
	.brush-button {
		position: relative;
		display: inline-grid;
		place-items: center;
		min-height: calc(var(--touch-target) + var(--space-m));
		padding: var(--space-s) var(--space-l);
		color: var(--color-brush-text);
		font-family: var(--font-heading);
		font-size: var(--step-2);
		list-style: none;
		cursor: pointer;
		isolation: isolate;
	}

	.brush-button::-webkit-details-marker {
		display: none;
	}

	.brush-button__stroke {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		fill: var(--color-brush);
		stroke: var(--color-brush);
	}

	/* Solid backing inside the stroke: keeps the label readable if the SVG
	   does not render, and lets contrast checkers see the real background */
	.brush-button__label {
		background: var(--color-brush);
		padding-inline: 0.15em;
	}

	/* Only on devices that really hover: on touch screens the underline
	   would stick after a tap */
	@media (hover: hover) {
		.brush-button:hover .brush-button__label {
			text-decoration: underline;
			text-underline-offset: 0.2em;
		}
	}

	.brush-button:focus-visible {
		outline-offset: 6px;
	}

	@media (min-width: 64rem) {
		.contact {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			column-gap: var(--space-xl);
			align-items: start;
		}

		.contact__title {
			grid-column: 1 / -1;
		}

		.contact__form {
			text-align: center;
		}

		.contact__form > :global(form) {
			text-align: start;
		}
	}
</style>
