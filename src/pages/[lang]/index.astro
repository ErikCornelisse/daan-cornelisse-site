---
// Style preview of the section bands in both languages. The bands get their
// real content in steps 4–6 of phase 1.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import LanguageSwitch from '../../components/LanguageSwitch.astro';
import { languages, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
	return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Temporary placeholder text until the content collections arrive (step 5).
const placeholder = {
	nl: 'Voor een uitzending om meer bewustwording rondom epilepsie te creëren vroeg EpilepsieNL mij één van mijn pianostukken te spelen. Het stuk “Yesterday is gone” schreef ik ’s avonds nadat ik een hevige aanval had gehad en weerspiegeld de vergankelijkheid van tijd.',
	en: 'For a broadcast to raise awareness of epilepsy, EpilepsieNL asked me to play one of my piano pieces. I wrote “Yesterday is gone” one evening after a severe seizure; it reflects how fleeting time is.',
}[lang];
const quote = {
	nl: '“Als kind heb ik een hele slechte motoriek gehad, grappig dat je dan achter de piano belandt.”',
	en: '“As a child my motor skills were really poor, funny that you then end up at the piano.”',
}[lang];
---

<BaseLayout title={t('site.title')} lang={lang} description={t('site.description')} path="">
	<header class="container topbar">
		<LanguageSwitch lang={lang} />
	</header>
	<main>
		<Section>
			<div class="flow">
				<h2 class="centred">{t('section.works')}</h2>
				<h3 class="accent-purple">Als het licht even uitgaat</h3>
				<div class="text-columns flow">
					<p>{placeholder}</p>
					<p>{placeholder}</p>
				</div>
			</div>
		</Section>

		<Section variant="paper">
			<div class="flow">
				<h3 class="accent-white">Tijd Voor MAX</h3>
				<div class="text-columns flow">
					<p>{placeholder}</p>
					<blockquote>
						<p>{quote}</p>
					</blockquote>
				</div>
			</div>
		</Section>

		<Section>
			<div class="flow">
				<h3 class="accent-orange">Voor ik sluit</h3>
				<div class="text-columns flow">
					<p>{placeholder}</p>
					<p>{placeholder}</p>
				</div>
			</div>
		</Section>

		<Section variant="paper" id={t('id.about')}>
			<div class="flow">
				<h2 class="centred">{t('section.about')}</h2>
				<p class="measure">{placeholder}</p>
				<p class="measure">{placeholder}</p>
			</div>
		</Section>

		<Section id={t('id.contact')}>
			<div class="flow">
				<h2 class="centred">{t('section.contact')}</h2>
				<p class="measure">{placeholder}</p>
			</div>
		</Section>
	</main>
</BaseLayout>

<style>
	.topbar {
		display: flex;
		justify-content: flex-end;
		padding-block: var(--space-xs);
	}

	.centred {
		text-align: center;
	}

	.measure {
		max-width: var(--measure);
	}

	.accent-purple {
		color: var(--color-accent-purple);
	}

	.accent-white {
		color: var(--color-accent-white);
	}

	.accent-orange {
		color: var(--color-accent-orange);
	}

	blockquote {
		font-style: italic;
	}
</style>
