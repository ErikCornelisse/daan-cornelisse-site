---
// Landing page in both languages, built from src/content/page.json: the
// hero, the sections in between, and contact (see src/lib/page.ts).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import Contact from '../../components/Contact.astro';
import ContentSection from '../../components/ContentSection.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import { languages, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { loadPage } from '../../lib/page';

export function getStaticPaths() {
	return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const page = await loadPage(lang);
---

<BaseLayout title={t('site.title')} lang={lang} description={t('site.description')} path="">
	<Header lang={lang} overlay />
	<main>
		{
			page.sections.map((section) => {
				if (section.ref.type === 'hero') return <Hero section={section} linkAnchor={page.heroLink} />;
				if (section.ref.type === 'contact')
					return (
						<section
							id={section.anchor}
							aria-labelledby={section.headingId}
							lang={section.fallback ? section.lang : undefined}
						>
							<Band variant={section.band}>
								<Contact lang={lang} section={section} />
							</Band>
						</section>
					);
				return <ContentSection section={section} />;
			})
		}
	</main>
</BaseLayout>
