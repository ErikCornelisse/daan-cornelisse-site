---
// Temporary page for choosing the heading and body fonts (phase 1, step 2).
// Remove it, and the fonts that were not chosen, once the pair is picked.
import '@fontsource/tenor-sans/400.css';
import '@fontsource/marcellus/400.css';
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource/crimson-pro/400.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const headings = ['Belleza', 'Tenor Sans', 'Marcellus', 'Optima'];
const bodies = ['Source Serif 4', 'Libre Caslon Text', 'Crimson Pro'];
const text =
	'Wat je van de buitenkant ziet is maar een klein gedeelte van iemands verhaal. Iets wat we steeds vaker lijken te vergeten. In haar biografie deelt Marije van der Kooij haar ervaringen rondom het opgroeien met epilepsie.';
---

<BaseLayout title="Lettertypen vergelijken">
	<main>
		<Section>
			<div class="flow">
				<h1>Lettertypen</h1>
				<p>Koppen: {headings.join(', ')} (Optima alleen als het op dit apparaat staat, als referentie).</p>
				<p>Tekst: {bodies.join(', ')}.</p>
			</div>
		</Section>
		{
			headings.map((heading, i) => (
				<Section variant={i % 2 ? 'paper' : 'cream'}>
					<div class="flow">
						<p class="label">Kop: {heading}</p>
						<h2 style={`font-family: '${heading}'`}>Een kijkje in mijn hoofd</h2>
						<h3 style={`font-family: '${heading}'; color: var(--color-accent-purple)`}>
							Als het licht even uitgaat
						</h3>
						<div class="samples">
							{bodies.map((body) => (
								<div class="flow">
									<p class="label">Tekst: {body}</p>
									<p style={`font-family: '${body}'`}>{text}</p>
								</div>
							))}
						</div>
					</div>
				</Section>
			))
		}
	</main>
</BaseLayout>

<style>
	.label {
		font-family: system-ui, sans-serif;
		font-size: var(--step--1);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.samples {
		display: grid;
		gap: var(--space-l);
	}

	@media (min-width: 64rem) {
		.samples {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
