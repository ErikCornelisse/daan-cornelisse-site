---
// Root page: sends the visitor to /nl/ or /en/, in this order:
//   1. a choice made earlier with the language switch;
//   2. Dutch when the device is in the Netherlands: time zone Europe/Amsterdam,
//      or a preferred language with region NL (nl-NL, en-NL, …);
//   3. the first Dutch or English entry in the browser's preferred languages;
//   4. English.
// Without JavaScript the two links below do the job.
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import { langStorageKey } from '../i18n/ui';
import { localeUrl } from '../i18n/utils';

const nlUrl = localeUrl('nl');
const enUrl = localeUrl('en');
---

<BaseLayout title="Daan Cornelisse" lang="en">
	<script is:inline slot="head" define:vars={{ nlUrl, enUrl, langStorageKey }}>
		var choice;
		try {
			choice = localStorage.getItem(langStorageKey);
		} catch (e) {}
		if (choice !== 'nl' && choice !== 'en') {
			var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
			var codes = [];
			for (var i = 0; i < prefs.length; i++) codes.push(String(prefs[i]).toLowerCase());
			var zone = '';
			try {
				zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
			} catch (e) {}
			var inNetherlands = zone === 'Europe/Amsterdam';
			for (var j = 0; j < codes.length && !inNetherlands; j++) {
				if (/-nl(-|$)/.test(codes[j])) inNetherlands = true;
			}
			choice = inNetherlands ? 'nl' : 'en';
			for (var k = 0; k < codes.length && !inNetherlands; k++) {
				if (codes[k].indexOf('nl') === 0) { choice = 'nl'; break; }
				if (codes[k].indexOf('en') === 0) break;
			}
		}
		location.replace((choice === 'nl' ? nlUrl : enUrl) + location.hash);
	</script>
	<main>
		<Band>
			<div class="flow chooser">
				<h1>Daan Cornelisse</h1>
				<ul role="list">
					<li><a href={nlUrl} hreflang="nl" lang="nl">Nederlands</a></li>
					<li><a href={enUrl} hreflang="en">English</a></li>
				</ul>
			</div>
		</Band>
	</main>
</BaseLayout>

<style>
	.chooser {
		min-height: 60vh;
		display: grid;
		place-content: center;
		text-align: center;
	}

	ul {
		display: flex;
		justify-content: center;
		gap: var(--space-m);
		padding: 0;
		list-style: none;
		font-size: var(--step-1);
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-target);
	}
</style>
