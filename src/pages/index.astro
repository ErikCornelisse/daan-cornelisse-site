---
// Style preview of the section bands. Replaced by the real landing page in
// steps 3–6 of phase 1.
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const placeholder =
	'Voor een uitzending om meer bewustwording rondom epilepsie te creëren vroeg EpilepsieNL mij één van mijn pianostukken te spelen. Het stuk “Yesterday is gone” schreef ik ’s avonds nadat ik een hevige aanval had gehad en weerspiegeld de vergankelijkheid van tijd.';
---

<BaseLayout title="Daan Cornelisse">
	<main>
		<Section>
			<div class="flow">
				<h2 class="centred">Mediums en Disciplines</h2>
				<h3 class="accent-purple">Als het licht even uitgaat</h3>
				<div class="text-columns flow">
					<p>{placeholder}</p>
					<p>{placeholder}</p>
				</div>
			</div>
		</Section>

		<Section variant="paper">
			<div class="flow">
				<h3 class="accent-white">Tijd Voor MAX</h3>
				<div class="text-columns flow">
					<p>{placeholder}</p>
					<blockquote>
						<p>“Als kind heb ik een hele slechte motoriek gehad, grappig dat je dan achter de piano belandt.”</p>
					</blockquote>
				</div>
			</div>
		</Section>

		<Section>
			<div class="flow">
				<h3 class="accent-orange">Voor ik sluit</h3>
				<div class="text-columns flow">
					<p>{placeholder}</p>
					<p>{placeholder}</p>
				</div>
			</div>
		</Section>

		<Section variant="paper" id="over-mij">
			<div class="flow">
				<h2 class="centred">Over mij</h2>
				<p class="measure">{placeholder}</p>
				<p class="measure">{placeholder}</p>
			</div>
		</Section>

		<Section id="contact">
			<div class="flow">
				<h2 class="centred">Contact</h2>
				<p class="measure">{placeholder}</p>
			</div>
		</Section>
	</main>
</BaseLayout>

<style>
	.centred {
		text-align: center;
	}

	.measure {
		max-width: var(--measure);
	}

	.accent-purple {
		color: var(--color-accent-purple);
	}

	.accent-white {
		color: var(--color-accent-white);
	}

	.accent-orange {
		color: var(--color-accent-orange);
	}

	blockquote {
		font-style: italic;
	}
</style>
